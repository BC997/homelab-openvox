#!/usr/bin/env python3
# Managed by Open Source Puppet (profile::container_check)
"""After a boot, check that every auto restart container came back.

Run once per boot by container-check.timer (OnBootSec=5min). Every container
whose restart policy is unless-stopped or always must be running, except the
names in IGNORE. Rechecks every 60 seconds for WAIT_MINUTES so slow starters
get time. If any are still down, or fewer than EXPECTED_COUNT auto restart
containers exist, or docker can't be queried, it posts one report to HA.
It never starts, stops or changes a container.

  container-check           the check (what the timer runs)
  container-check --status  check once now and print, send nothing
  container-check --test    send a test alert to HA now
"""
import json
import os
import socket
import subprocess
import sys
import time
import urllib.request

ENV_FILE = '/etc/default/container-check'
DOCKER = '/usr/bin/docker'
AUTO = {'unless-stopped', 'always'}

# systemd passes the env file in; a manual run (sudo container-check) reads it here
try:
    with open(ENV_FILE) as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith('#') and '=' in line:
                key, val = line.split('=', 1)
                os.environ.setdefault(key.strip(), val.strip())
except OSError:
    pass

URL = os.environ.get('HA_WEBHOOK_URL', '')
EXPECTED = int(os.environ.get('EXPECTED_COUNT', '0'))
IGNORE = {n.strip() for n in os.environ.get('IGNORE', '').split(',') if n.strip()}
WAIT_MIN = int(os.environ.get('WAIT_MINUTES', '10'))


def docker(*args):
    return subprocess.run([DOCKER, *args], capture_output=True, text=True,
                          timeout=60, check=True).stdout


def auto_containers():
    """Return [(name, policy, status)] for auto restart containers not ignored."""
    ids = docker('ps', '-aq', '--no-trunc').split()
    if not ids:
        return []
    fmt = '{{.Name}}\t{{.HostConfig.RestartPolicy.Name}}\t{{.State.Status}}'
    rows = []
    for line in docker('inspect', '--format', fmt, *ids).splitlines():
        parts = line.split('\t')
        if len(parts) != 3:
            continue
        name, policy, status = parts[0].lstrip('/'), parts[1], parts[2]
        if policy in AUTO and name not in IGNORE:
            rows.append((name, policy, status))
    return rows


def check():
    """Return (found, down, error)."""
    try:
        rows = auto_containers()
    except (OSError, subprocess.SubprocessError) as err:
        return 0, [], f'docker query failed: {err}'
    down = sorted(f'{n} ({s})' for n, _, s in rows if s != 'running')
    return len(rows), down, ''


def post(payload):
    if not URL:
        print('HA_WEBHOOK_URL is not set, nothing sent', file=sys.stderr)
        return False
    req = urllib.request.Request(
        URL,
        data=json.dumps(payload).encode(),
        headers={'Content-Type': 'application/json'},
        method='POST',
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            resp.read()
        return True
    except Exception as err:  # report any network or HTTP failure
        print(f'Post to Home Assistant failed: {err}', file=sys.stderr)
        return False


def main():
    host = socket.gethostname().split('.')[0].lower()
    arg = sys.argv[1] if len(sys.argv) > 1 else ''

    if arg == '--test':
        ok = post({'host': host, 'expected': EXPECTED, 'found': EXPECTED,
                   'running': EXPECTED - 1, 'down': ['test-container (exited)'],
                   'error': '', 'test': True})
        print('Test alert sent' if ok else 'Test alert failed')
        return 0 if ok else 1

    deadline = time.time() + WAIT_MIN * 60
    while True:
        found, down, error = check()
        short = found < EXPECTED
        healthy = not error and not down and not short
        if healthy or arg == '--status' or time.time() >= deadline:
            break
        time.sleep(60)

    running = found - len(down)
    print(f'{running} of {found} auto restart containers running '
          f'(expected {EXPECTED}, ignoring {len(IGNORE)})')
    if down:
        print('Down: ' + ', '.join(down))
    if error:
        print(error)

    if arg == '--status' or healthy:
        return 0

    ok = post({'host': host, 'expected': EXPECTED, 'found': found,
               'running': running, 'down': down, 'error': error, 'test': False})
    return 0 if ok else 1


if __name__ == '__main__':
    sys.exit(main())
